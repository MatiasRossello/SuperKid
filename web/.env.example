# SuperKid · variables de entorno
# Copiá este archivo a .env.local (local) o cargalas en Vercel (Settings → Environment Variables).
# Nunca commitees .env.local.

# ── Supabase ────────────────────────────────────────────────
# Project Settings → API. Sin estas dos, la app lee las fuentes en vivo y no guarda nada.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# service_role: solo servidor, saltea RLS. No la uses en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resúmenes (OpenRouter) ─────────────────────────────────
# https://openrouter.ai/keys. Sin clave, se usa la plantilla fija.
OPENROUTER_API_KEY=
# Modelo del pipeline real. Opciones: ver src/lib/models.ts
#   nvidia/nemotron-3.5-super-vl | baidu/ernie-5.5-flash-preview:free | anthropic/claude-haiku-5.5
SUMMARY_MODEL=nvidia/nemotron-3.5-super-vl
# Opcional: clave para usar /lab (gasta créditos). Vacía = /lab abierto.
LAB_SECRET=

# ── Poller ──────────────────────────────────────────────────
# Secreto que pg_cron manda a /api/poll (el mismo va en supabase/cron.sql).
# Generar: openssl rand -hex 24
CRON_SECRET=

# ── Push (Web Push / VAPID) ────────────────────────────────
# Generar: npx web-push generate-vapid-keys
# La pública va dos veces: una para el servidor y otra expuesta al navegador.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push (mailto: o https:)
VAPID_SUBJECT=mailto:tu-mail@ejemplo.com

# ── SMN (opcional) ──────────────────────────────────────────
# JWT que genera smn.gob.ar/alertas. Vacío = fuente SMN apagada.
SMN_JWT=

# ── API para bots (Grokbot) ────────────────────────────────
# Token que Grokbot manda en "Authorization: Bearer ...". Vacío = /api/v1/zonas cerrada.
# Generar: openssl rand -hex 24
GROKBOT_TOKEN=
